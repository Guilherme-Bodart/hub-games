{
  "expo": {
    "name": "hub-games",
    "slug": "hub-games",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hubgames",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.outrigger.hubgames"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5bb0960-b846-41fd-b9ea-e11ce4c95f1d"
      }
    }
  }
}
